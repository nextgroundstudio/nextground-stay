---js
// Règlement intérieur, version de LECTURE : publique, liée dans le pied de page et la carte de réservation,
// pour que les voyageurs le lisent avant toute demande. Pas de formulaire ici.
// La version à signer est house-rules-sign.njk (même texte, lien envoyé après la réservation).
// N'y mettez jamais de code d'accès ni de mot de passe.
const pagination = { data: "langs", size: 1, alias: "lang" };
const permalink = (data) => data.routes.houseRules[data.lang.code];
const layout = "layouts/base.njk";
const pageKey = "houseRules";
const eleventyComputed = {
  title: (data) => `${data.i18n[data.lang.code].houseRules.title} — Next Ground Stay`,
  description: (data) => data.i18n[data.lang.code].houseRules.metaDescription,
};
---
{%- set t = i18n[lang.code] -%}
{%- set doc = legal.houseRules[lang.code] -%}
<article class="container prose">
  <p class="label">{{ site.name }}</p>
  <h1>{{ t.houseRules.title }}</h1>
  <p class="small muted">{{ "Last updated:" if lang.code == "en" else "Mise à jour :" }} {{ legal.houseRules.updated | readableDate(lang.locale) }}</p>
  <p class="lead">{{ t.houseRules.intro }}</p>
{% include "partials/house-rules-list.njk" %}
</article>
