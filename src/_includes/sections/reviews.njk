{#- Avis voyageurs (données : home.reviews). -#}
<section class="section section--tint" id="reviews">
  <div class="container">
    <div class="section__head">
      <div>
        <p class="label">{{ t.reviews.kicker }}</p>
        <h2>{{ t.reviews.title }}</h2>
      </div>
      <p class="rating"><span class="stars" aria-hidden="true">★★★★★</span> {{ t.reviews.summary | fill({ rating: home.reviews.rating, count: home.reviews.items.length }) }}</p>
    </div>
    {%- set n = home.reviews.items | length %}
    <div class="reviews{% if n > 2 %} reviews--many-m{% endif %}{% if n > 3 %} reviews--many-d{% endif %}" data-reviews tabindex="0" aria-label="{{ t.reviews.kicker }}">
      {%- for r in home.reviews.items %}
      <figure class="review">
        <div>
          <p class="stars" aria-label="{{ t.reviews.stars }}">★★★★★</p>
          <blockquote lang="{{ r.lang }}">{{ "« " if lang.code == "fr" else "“" }}{{ r.text }}{{ " »" if lang.code == "fr" else "”" }}</blockquote>
        </div>
        <figcaption>
          <span class="avatar" aria-hidden="true">{{ r.name | first }}</span>
          <span class="review__who"><strong>{{ r.name }}</strong><span>{{ r.meta | loc(lang.code) }}</span></span>
        </figcaption>
      </figure>
      {%- endfor %}
    </div>
    {%- if n > 2 %}
    <div class="reviews__nav">
      <button type="button" data-reviews-prev aria-label="{{ t.reviews.prev }}">{{ icons.icon("chevron-left", 16) }}</button>
      <button type="button" data-reviews-next aria-label="{{ t.reviews.next }}">{{ icons.icon("chevron-right", 16) }}</button>
    </div>
    {%- endif %}
  </div>
</section>
