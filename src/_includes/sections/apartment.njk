{#- L'appartement : galerie, caractéristiques, équipements, encadré prix. -#}
<section class="section" id="apartment">
  <div class="container">
    <div class="gallery">
      {#- Chaque photo s'ouvre en grand au clic (data-open-photo = sa position dans home.photos) -#}
      {%- set p = home.photos[1] %}
      <button class="gallery__main gallery__item" type="button"{% if p.position %} style="--pos: {{ p.position }}"{% endif %} data-open-photo="1" data-open-photo-mobile="0" aria-label="{{ p.alt | loc(lang.code) }}">{% galleryPhoto p.file, home.photos[0].file, p.alt | loc(lang.code) %}</button>
      <div class="gallery__grid">
        {%- for p in home.photos.slice(2, 6) %}
        <button class="gallery__item" type="button" data-open-photo="{{ loop.index + 1 }}" aria-label="{{ p.alt | loc(lang.code) }}">{% photo p.file, p.alt | loc(lang.code), "(min-width: 900px) 20vw, 50vw" %}</button>
        {%- endfor %}
        {#- Bouton posé sur la dernière vignette, comme sur les plateformes de location -#}
        <button class="gallery__all" type="button" data-open-photo="1">{{ t.apartment.allPhotos }} ({{ home.photos.length }})</button>
      </div>
    </div>

    <div class="apartment">
      <div class="apartment__info">
        <p class="label">{{ t.apartment.kicker }}</p>
        <h2>{{ site.apartmentName }}</h2>
        <p class="apartment__subtitle">{{ t.apartment.title }}</p>
        <p class="muted">{{ t.apartment.address | fill }}</p>
        <ul class="amenities">
          {%- for a in home.amenities %}
          <li>{{ icons.icon(a.icon) }}<span>{{ a[lang.code] }}</span></li>
          {%- endfor %}
        </ul>
        {#- Liste complète (home.amenitiesAll), repliée par défaut -#}
        <details class="all-amenities">
          <summary>{{ t.apartment.allAmenities }}</summary>
          <div class="all-amenities__groups">
            {%- for g in home.amenitiesAll %}
            <div>
              <p class="label">{{ g.title | loc(lang.code) }}</p>
              <ul>{% for item in g.items[lang.code] %}<li>{{ item }}</li>{% endfor %}</ul>
            </div>
            {%- endfor %}
          </div>
        </details>
      </div>

      <aside class="price-card">
        <p class="price-card__price">
          {{ t.apartment.from }}
          <strong data-price='{{ site.prices.nightlyFrom | json }}'>{{ site.prices.nightlyFrom[site.currencies[0]] | money(site.currencies[0], lang.locale) }}</strong>
          {{ t.apartment.perNight }}
        </p>
        <ul class="checks">
          {%- for perk in t.apartment.perks %}
          <li>{{ icons.icon("check", 16) }}{{ perk | fill }}</li>
          {%- endfor %}
        </ul>
        <a class="btn btn--block" href="#book">{{ t.apartment.cta }}</a>
        <p class="small muted">{{ t.apartment.note }}</p>
      </aside>
    </div>
  </div>

  {#- Visionneuse plein écran : une photo à la fois, flèches, clavier et glissement du doigt -#}
  <dialog class="viewer" data-viewer aria-label="{{ t.apartment.allPhotos }}">
    <button class="viewer__btn viewer__close" type="button" data-viewer-close aria-label="{{ t.nav.close }}">×</button>
    <button class="viewer__btn viewer__prev" type="button" data-viewer-prev aria-label="{{ t.calendar.prev }}">{{ icons.icon("chevron-left", 22) }}</button>
    <button class="viewer__btn viewer__next" type="button" data-viewer-next aria-label="{{ t.calendar.next }}">{{ icons.icon("chevron-right", 22) }}</button>
    <div class="viewer__slides">
      {%- for p in home.photos %}
      <figure class="viewer__slide" data-slide hidden>{% photo p.file, p.alt | loc(lang.code), "100vw" %}<figcaption>{{ p.alt | loc(lang.code) }}</figcaption></figure>
      {%- endfor %}
    </div>
    <p class="viewer__count" data-viewer-count></p>
  </dialog>
</section>
