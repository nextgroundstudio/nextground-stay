{#- Questions fréquentes : liste dans i18n.js (faq.items), une question = { q, a }. -#}
<section class="section" id="faq">
  <div class="container faq">
    <div>
      <p class="label">{{ t.faq.kicker }}</p>
      <h2>{{ t.faq.title }}</h2>
    </div>
    <div class="faq__list">
      {%- for item in t.faq.items %}
      <details>
        <summary>{{ item.q }}</summary>
        <p>{{ item.a }}</p>
      </details>
      {%- endfor %}
    </div>
  </div>
</section>
