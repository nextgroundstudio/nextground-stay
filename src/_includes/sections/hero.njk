{#- Accueil : tagline, phrase d'accroche, deux actions, grande photo, repères du quartier. -#}
<section class="hero">
  <div class="container hero__top">
    <h1 class="hero__title">{{ t.hero.title | safe }}</h1>
    <div class="hero__side">
      <p class="lead">{{ t.hero.lead }}</p>
      <div class="actions">
        <a class="btn" href="https://wa.me/{{ site.contact.whatsapp }}" data-wa-link>{{ icons.icon("whatsapp", 16) }}{{ t.hero.whatsapp }}</a>
        <a class="link" href="#book">{{ t.hero.dates }}</a>
      </div>
      <p class="small muted">{{ t.hero.response }}</p>
    </div>
  </div>
  <div class="container">
    {%- set p = home.photos[0] %}
    <div class="hero__photo">{% photo p.file, p.alt | loc(lang.code), "(min-width: 1320px) 1272px, 100vw", true %}</div>
    <ul class="highlights">
      <li class="label">{{ t.hero.area }}</li>
      {%- for h in home.highlights %}
      <li><strong>{{ h.name | loc(lang.code) }}</strong> {{ h.time | loc(lang.code) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>
