{#- Accueil : tagline, phrase d'accroche, une action, grande photo, repères du quartier.
    Ordinateur : tagline et texte au-dessus de la photo.
    Mobile : la photo occupe tout l'écran, bord à bord, avec la tagline posée dessus (voir main.css). -#}
<section class="hero">
  <div class="container hero__grid">
    {#- La tagline est un élément visuel ; le titre principal (h1), lu par Google, décrit l'offre
        et s'affiche comme le début de la phrase d'accroche. -#}
    <p class="hero__title">{{ t.hero.title | safe }}</p>
    <div class="hero__side">
      <div class="lead"><h1 class="hero__h1">{{ t.hero.h1 }}</h1>{% if t.hero.lead %} {{ t.hero.lead }}{% endif %}</div>
      {#- Prix « à partir de », visible dès l'accueil (la devise suit le sélecteur de l'en-tête) -#}
      <p class="hero__price">{{ t.apartment.from }} <strong data-price='{{ site.prices.nightlyFrom | json }}'>{{ site.prices.nightlyFrom[site.currencies[0]] | money(site.currencies[0], lang.locale) }}</strong> {{ t.apartment.perNight }} <span class="muted">· {{ t.hero.priceNote }}</span></p>
      <a class="btn hero__cta" href="https://wa.me/{{ site.contact.whatsapp }}" data-wa-link>{{ icons.icon("whatsapp", 16) }}{{ t.hero.whatsapp }}</a>
      <p class="small muted">{{ t.hero.response }}</p>
    </div>
    {%- set p = home.photos[0] %}
    <div class="hero__photo" style="--pos: {{ p.position or 'center' }}; --pos-m: {{ home.heroMobilePosition or 'center' }}">{% heroPhoto p.file, home.heroMobile, p.alt | loc(lang.code) %}</div>
    <ul class="highlights">
      <li class="label">{{ t.hero.area }}</li>
      {%- for h in home.highlights %}
      <li><strong>{{ h.name | loc(lang.code) }}</strong> {{ h.time | loc(lang.code) }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>
